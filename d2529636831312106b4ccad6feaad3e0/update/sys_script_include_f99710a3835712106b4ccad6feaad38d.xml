        <script><![CDATA[var AooPemyUtilsAjax = Class.create();
AooPemyUtilsAjax.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	
    isTrainingDateAvailable: function() {
	var  trainingName = this.getParameter("sysparm_training_name");
	var  trainingDate = this.getParameter("sysparm_training_date");

        var gr = new GlideRecord('x_1590789_aoopemy_training_schedules');
        gr.addQuery('training_name', trainingName);
        gr.addQuery('training_date', trainingDate);
        gr.query();

		gs.log("Excutei a query");
		gs.info("Excutei a query");
        return !gr.hasNext(); // Retorna true se não houver registros
	},
	
    type: 'AooPemyUtilsAjax'
});]]></script>
