        <messages/>
        <name>Validate Training Date</name>
        <order/>
        <script><![CDATA[function onSubmit() {
   //Type appropriate comment here, and begin script below
   // Pega o valor do campo training_name
    var trainingName = g_form.getValue('training_name');
    var inputDate = g_form.getValue('training_date');
    var inputDateToCompare = inputDate.split('-').reverse().join('-');

    // Cria uma chamada GlideAjax para o Script Include
    var ga = new GlideAjax('AooPemyUtils');
    ga.addParam('sysparm_name', 'isTrainingDateAvailable'); // Método do Script Include
    ga.addParam('sysparm_training_name', trainingName); // Parâmetro 1
    ga.addParam('sysparm_training_date', inputDateToCompare); // Parâmetro 2
    console.log(trainingName);
    console.log(inputDate);
    console.log(inputDateToCompare);

/*
	ga.getXML(callBackFunction);
	function callBackFunction(response) {
        var resposta = response.responseXML.documentElement.getAttribute("answer");
		console.log(response);
		console.log(resposta + " resposta");
	}
*/   
    // Executa a chamada e processa a resposta
    ga.getXMLAnswer(function(response) {
        console.log('chegou aqui');
        console.log(response);
        if (response === 'false') { // Se já existir um registro
            alert('Já existe um treinamento com o mesmo nome na data selecionada. Por favor, escolha outra data.');
            g_form.setValue('training_date', ''); // Limpa o campo training_date
			awnser = false;
        }
    });
}]]></script>
